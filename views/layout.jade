doctype html
html
  head
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title
  body
    header
      h1 Sistema de restaurante
      nav
        if user
          a(href='/') Inicio
          |  |
          a(href='/restaurant/clientes') Clientes
          |  |
          a(href='/restaurant/mozos') Mozos
          |  |
          a(href='/restaurant/cocineros') Cocineros
          |  |
          a(href='/restaurant/productos') Productos
          |  |
          a(href='/restaurant/tickets') Tickets
          |  |
          if user.role === 'admin'
            a(href='/auth/register') Crear usuario
            |  |
          | #{user.email} (#{user.role})
          form(action='/auth/logout' method='post')
            button(type='submit') Cerrar sesión
    hr
    main
      block content
