doctype html
html
  head
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= title
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    header
      h1 Sistema de restaurante
      nav
        if user
          a(href='/') Inicio
          |  |
          a(href='/restaurant/clientes') Clientes
          |  |
          a(href='/restaurant/mozos') Mozos
          |  |
          a(href='/restaurant/cocineros') Cocineros
          |  |
          a(href='/restaurant/productos') Productos
          |  |
          a(href='/restaurant/tickets') Tickets
          |  |
          form.inline-form(action='/auth/logout' method='post')
            button(type='submit') Cerrar sesión
    hr
    main
      block content
