extends layout

block content
  h1= title

  if editUser
    h2 Editar usuario
    form(action='/users/view/edit/' + editUser.id method='post')
      label(for='name') Nombre
      input#name(type='text' name='name' value=editUser.name required)
      label(for='email') Correo
      input#email(type='email' name='email' value=editUser.email)
      button(type='submit') Guardar cambios
      a(href='/users/view') Cancelar
  else
    h2 Nuevo usuario
    form(action='/users/view' method='post')
      label(for='name') Nombre
      input#name(type='text' name='name' required)
      label(for='email') Correo
      input#email(type='email' name='email')
      button(type='submit') Guardar usuario

  h2 Usuarios registrados
  if users.length
    table
      thead
        tr
          th ID
          th Nombre
          th Correo
          th Acciones
      tbody
        each user in users
          tr
            td= user.id
            td= user.name
            td= user.email
            td
              a(href='/users/view/edit/' + user.id) Editar
              form(action='/users/view/delete/' + user.id method='post')
                button(type='submit') Eliminar
  else
    p No hay usuarios registrados.
