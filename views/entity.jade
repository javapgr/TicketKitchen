extends layout

block content
  p
    a(href='/') Inicio
  h2= title

  if canWrite
    h3= editRow ? 'Editar registro' : 'Agregar registro'
    form(action=editRow ? '/restaurant/' + entityName + '/edit/' + editRow.id : '/restaurant/' + entityName method='post')
      each field in formFields
        p
          label(for=field)= field.replace(/_/g, ' ')
          br
          if selects[field]
            select(name=field id=field required)
              each option in selects[field]
                option(value=option.value selected=editRow && String(editRow[field]) === String(option.value))= option.label
          else if relationOptions[field]
            select(name=field id=field required=(field === 'mozo_id'))
              if field === 'cliente_id' || field === 'cocinero_id'
                option(value='' selected=!editRow || !editRow[field]) Sin asignar
              each option in relationOptions[field]
                option(value=option.id selected=editRow && String(editRow[field]) === String(option.id))= option.nombre
          else
            input(
              type=(field === 'precio' ? 'number' : field === 'tiempo_preparacion_min' || field === 'numero_mesa' ? 'number' : 'text')
              name=field
              id=field
              value=(editRow ? editRow[field] : '')
              step=field === 'precio' ? '0.01' : undefined
              min=field === 'precio' || field === 'tiempo_preparacion_min' || field === 'numero_mesa' ? '0' : undefined
              required
            )
      p
        button(type='submit')= editRow ? 'Guardar cambios' : 'Guardar'
        if editRow
          |  
          a(href='/restaurant/' + entityName) Cancelar

  h3 Registros
  if rows.length
    table(border='1' cellpadding='4')
      thead
        tr
          th ID
          each field in fields
            th= field.replace(/_/g, ' ')
          if canWrite || canDelete
            th Acciones
      tbody
        each row in rows
          tr
            td= row.id
            each field in fields
              td
                if field === 'disponible'
                  | #{row[field] === 1 ? 'Sí' : 'No'}
                else if relationOptions[field]
                  each option in relationOptions[field]
                    if option.id === row[field]
                      | #{option.nombre}
                else
                  | #{row[field]}
            if canWrite || canDelete
              td
                if canWrite
                  a(href='/restaurant/' + entityName + '/edit/' + row.id) Editar
                if canWrite && canDelete
                  |  |
                if canDelete
                  form(action='/restaurant/' + entityName + '/delete/' + row.id method='post')
                    button(type='submit') Eliminar
  else
    p No hay registros.
